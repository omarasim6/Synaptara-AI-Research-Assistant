# ─────────────────────────────────────────────────────────────
#  Synaptara Backend — Environment Variables
#  These defaults work out of the box with `docker compose up`.
#  Replace placeholder values before deploying anywhere public.
# ─────────────────────────────────────────────────────────────

# PostgreSQL — overridden by docker-compose.yml's `environment:` block when
# running via Docker (points at the `db` service instead of localhost).
DATABASE_URL=postgresql+asyncpg://synaptara:synaptara_pass@localhost:5432/synaptara

# JWT — freshly generated for this project. Generate your own for any
# real/shared deployment with: openssl rand -hex 32
SECRET_KEY=2f88724666e39fb9bab5e789a9c515106473d8bebacff2e3ced21f8544588692
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Internal API key (reserved for future Next.js server → FastAPI auth)
BACKEND_API_KEY=db63cf61059677543a3c60077db7d234b0415c0589196f0e

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# App
APP_NAME=Synaptara
APP_ENV=development
DEBUG=true

# AI provider — "ollama" (free, local, default) or "openai" (paid, real web search)
AI_PROVIDER=ollama

# Ollama — local model server running on your host machine.
# host.docker.internal lets the api container reach Ollama on your host
# (works on Docker Desktop for Windows/Mac/Linux — the compose file adds
# the needed host-gateway mapping). Install Ollama, run it, then pull the
# model: `ollama pull llama3.2:1b`
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b

# OpenAI — only used if AI_PROVIDER=openai above. Powers the
# general-knowledge RAG fallback (web search + answer) used when a search
# query isn't about research papers / AI. Get a key at
# https://platform.openai.com/api-keys and paste it below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe — billing / checkout (get test-mode keys at
# https://dashboard.stripe.com/test/apikeys). Leave blank to disable
# billing (the app runs fine without it — /billing/config reports disabled).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` (CLI) locally, or the webhook endpoint's signing secret in production
STRIPE_WEBHOOK_SECRET=

# Email (SMTP) — blank = log-only dev mode, no real email sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Synaptara <no-reply@synaptara.app>

WEEKLY_DIGEST_DAY_OF_WEEK=mon
WEEKLY_DIGEST_HOUR=8
