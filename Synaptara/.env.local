# ─────────────────────────────────────────
#  SYNAPTARA — Environment Variables
#  These defaults work out of the box with `docker compose up`.
#  Replace placeholder values before deploying anywhere public.
# ─────────────────────────────────────────

# NextAuth
# Freshly generated for this project. Generate your own for any real/shared
# deployment with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=t1b0c2todVY8UvdLrbeB1grtp45/KpNQ88lITpo/zYk=

# Google OAuth — optional. "Sign in with Google" is disabled until you fill
# these in. Create credentials at https://console.cloud.google.com/
#   APIs & Services → Credentials → OAuth 2.0 Client IDs
#   Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FastAPI backend URL used by the BROWSER (client-side fetches). Must be
# reachable from the user's machine, not just from inside Docker — this is
# why it's "localhost:8000" (the published port) and not "http://api:8000".
# Server-side calls (NextAuth, /api/register) instead use INTERNAL_API_URL,
# which docker-compose.yml sets separately to http://api:8000/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
